<Window x:Class="NekoDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nekodrop" Width="560" Height="640" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,20,0,8"/>
    </Style>
    <Style x:Key="Accent" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Subtle" TargetType="Button" BasedOn="{StaticResource Accent}">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24,16,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Status -->
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE701;" FontSize="20" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
      <StackPanel Margin="12,0,0,0">
        <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
      <StackPanel>
        <!-- Incoming requests -->
        <ItemsControl ItemsSource="{Binding Requests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock><Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" 想发送 "/><Run Text="{Binding What, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" BorderThickness="0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="接受" Style="{StaticResource Accent}" Click="Accept_Click" Tag="{Binding Id}"/>
                    <Button Content="拒绝" Style="{StaticResource Subtle}" Click="Decline_Click" Tag="{Binding Id}" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Devices -->
        <TextBlock Text="附近的设备" Style="{StaticResource Section}"/>
        <TextBlock x:Name="NoDevices" Style="{StaticResource Caption}" Margin="4,0,0,0" TextWrapping="Wrap"
                   Text="正在查找…  在 iPhone 上把 AirDrop 设为“所有人（10 分钟）”，它就会出现在这里。"/>
        <ItemsControl ItemsSource="{Binding Devices}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="Device_Click" Tag="{Binding}" Margin="0,0,8,8" Cursor="Hand" ToolTip="点击发送下面的文件">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="c" Width="120" Height="128" CornerRadius="8" Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" Padding="8">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="52" Height="52" Margin="0,4,0,6">
                    <Ellipse Fill="{DynamicResource Accent}" Opacity="0.15"/>
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="{Binding Glyph}" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
                  </Grid>
                  <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Files to send -->
        <Grid Margin="0,12,0,0">
          <TextBlock Text="要发送的文件" Style="{StaticResource Section}" Margin="4,8,0,8"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="添加文件…" Style="{StaticResource Subtle}" Click="Add_Click"/>
            <Button Content="清空" Style="{StaticResource Subtle}" Click="Clear_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
        <Border Background="{DynamicResource DropWell}" CornerRadius="8" BorderBrush="{DynamicResource Divider}" BorderThickness="1" MinHeight="88" Padding="12">
          <Grid>
            <TextBlock x:Name="DropHint" Text="把文件拖到这里，或在资源管理器里右键 → “用 nekodrop 发送”"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8A5;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- Received -->
        <TextBlock Text="最近收到" Style="{StaticResource Section}"/>
        <ItemsControl ItemsSource="{Binding ReceivedFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8" Cursor="Hand" MouseLeftButtonUp="Received_Click" Tag="{Binding Path}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                             Text="{Binding When, StringFormat=HH:mm}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Caption}"><Run Text="来自 "/><Run Text="{Binding From, Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock HorizontalAlignment="Left" Margin="4,12,0,0">
          <Hyperlink Click="OpenFolder_Click" Foreground="{DynamicResource AccentText}">打开接收文件夹</Hyperlink>
          <Run Text="   "/>
          <Hyperlink Click="Settings_Click" Foreground="{DynamicResource AccentText}">设置</Hyperlink>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
