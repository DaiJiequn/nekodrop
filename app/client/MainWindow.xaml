<Window x:Class="NekoDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="nekodrop" Width="600" Height="860" MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,20,0,8"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Subtle" TargetType="Button" BasedOn="{StaticResource AccentButton}">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24,16,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Status -->
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE701;" FontSize="20" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
      <StackPanel Margin="12,0,0,0">
        <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
      <StackPanel>
        <!-- Incoming requests -->
        <ItemsControl ItemsSource="{Binding Requests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardBox}" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock><Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{local:T main.wants}"/><Run Text="{Binding What, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" BorderThickness="0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="{local:T accept}" Style="{StaticResource AccentButton}" Click="Accept_Click" Tag="{Binding Id}"/>
                    <Button Content="{local:T decline}" Style="{StaticResource Subtle}" Click="Decline_Click" Tag="{Binding Id}" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Devices: radar or list (RadarView, shared with the send window) -->
        <local:RadarView Height="440" Margin="0,20,0,0"/>

        <!-- Files to send -->
        <Grid Margin="0,12,0,0">
          <TextBlock Text="{local:T main.files}" Style="{StaticResource Section}" Margin="4,8,0,8"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="{local:T main.add}" Style="{StaticResource Subtle}" Click="Add_Click"/>
            <Button Content="{local:T main.clear}" Style="{StaticResource Subtle}" Click="Clear_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
        <Border Background="{DynamicResource DropWell}" CornerRadius="8" BorderBrush="{DynamicResource Divider}" BorderThickness="1" MinHeight="88" Padding="12">
          <Grid>
            <TextBlock x:Name="DropHint" Text="{local:T main.dropHint}"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8A5;" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- Received -->
        <TextBlock Text="{local:T main.received}" Style="{StaticResource Section}"/>
        <ItemsControl ItemsSource="{Binding ReceivedFiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardBox}" Margin="0,0,0,6" Padding="12,8" Cursor="Hand" MouseLeftButtonUp="Received_Click" Tag="{Binding Path}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"
                             Text="{Binding When, StringFormat=HH:mm}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Style="{StaticResource Caption}"><Run Text="{local:T main.from}"/><Run Text="{Binding From, Mode=OneWay}"/></TextBlock>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource CardBox}" Margin="0,12,0,0" Padding="12,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{local:T main.change}" Style="{StaticResource Subtle}" Click="ChangeFolder_Click" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}" Text="&#xE8B7;" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:T main.saveTo}" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock HorizontalAlignment="Left" Margin="4,12,0,0">
          <Hyperlink Click="OpenFolder_Click" Foreground="{DynamicResource AccentText}"><Run Text="{local:T main.openFolder}"/></Hyperlink>
          <Run Text="   "/>
          <Hyperlink Click="Settings_Click" Foreground="{DynamicResource AccentText}"><Run Text="{local:T main.settings}"/></Hyperlink>
          <Run Text="   "/>
          <Hyperlink Click="Wifi_Click" Foreground="{DynamicResource AccentText}"><Run Text="{local:T wifi.tray}"/></Hyperlink>
          <Run Text="   "/>
          <Hyperlink Click="Report_Click" Foreground="{DynamicResource AccentText}"><Run Text="{local:T main.report}"/></Hyperlink>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
