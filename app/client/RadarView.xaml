<UserControl x:Class="NekoDrop.RadarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NekoDrop"
             Foreground="{DynamicResource Text}">
  <UserControl.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- Segmented radar / list switch -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="4" Padding="10,3" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{DynamicResource IconFont}" Text="{TemplateBinding Tag}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A button with no chrome of its own: the template draws everything -->
    <Style x:Key="Bare" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="AllowDrop" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Text}"/>
                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The colour of what became of a send: the outcome ring and the status text -->
    <Style x:Key="OutcomeRing" TargetType="Ellipse">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="StrokeThickness" Value="2"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="sent">
          <Setter Property="Visibility" Value="Visible"/><Setter Property="Stroke" Value="{DynamicResource Success}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="declined">
          <Setter Property="Visibility" Value="Visible"/><Setter Property="Stroke" Value="{DynamicResource Caution}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="failed">
          <Setter Property="Visibility" Value="Visible"/><Setter Property="Stroke" Value="{DynamicResource Critical}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="sent"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="declined"><Setter Property="Foreground" Value="{DynamicResource Caution}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="failed"><Setter Property="Foreground" Value="{DynamicResource Critical}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BusyRing" TargetType="local:ProgressRing">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
      <Setter Property="Track" Value="{DynamicResource Divider}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A device on the radar: icon on the orbit, name and status below -->
    <DataTemplate x:Key="RadarNode" DataType="local:Device">
      <Button Style="{StaticResource Bare}" Tag="{Binding}" Click="Node_Click"
              DragEnter="Node_DragEnter" DragOver="Node_DragOver" DragLeave="Node_DragLeave" Drop="Node_Drop"
              Width="116" ToolTip="{local:T main.deviceTip}"
              AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Status}">
        <StackPanel>
          <Grid Width="56" Height="56" HorizontalAlignment="Center">
            <Ellipse x:Name="Disc" Fill="{DynamicResource NodeFill}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1"/>
            <Ellipse Style="{StaticResource OutcomeRing}"/>
            <local:ProgressRing Style="{StaticResource BusyRing}" Progress="{Binding Progress}" Thickness="3"/>
            <TextBlock FontFamily="{DynamicResource IconFont}" Text="{Binding Glyph}" FontSize="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
          </Grid>
          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                     TextTrimming="CharacterEllipsis" Margin="2,6,2,0" ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" TextAlignment="Center" Margin="2,1,2,0"/>
        </StackPanel>
      </Button>
    </DataTemplate>

    <!-- The same device as a row of the list -->
    <DataTemplate x:Key="ListRow" DataType="local:Device">
      <Button Style="{StaticResource Bare}" Tag="{Binding}" Click="Node_Click" HorizontalContentAlignment="Stretch"
              DragEnter="Node_DragEnter" DragOver="Node_DragOver" DragLeave="Node_DragLeave" Drop="Node_Drop"
              Margin="0,0,0,4" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Status}">
        <Border x:Name="Row" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontFamily="{DynamicResource IconFont}" Text="&#xE724;" FontSize="14"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="12,0,4,0"/>
            <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0">
              <Ellipse x:Name="Disc" Fill="{DynamicResource NodeFill}" Stroke="{DynamicResource CardStroke}" StrokeThickness="1"/>
              <Ellipse Style="{StaticResource OutcomeRing}"/>
              <local:ProgressRing Style="{StaticResource BusyRing}" Progress="{Binding Progress}" Thickness="2.5"/>
              <TextBlock FontFamily="{DynamicResource IconFont}" Text="{Binding Glyph}" FontSize="17"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Status}">
                <TextBlock.Style>
                  <!-- No status yet: no empty line, so the name sits in the middle -->
                  <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Header: section title and the view switch -->
    <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
      <TextBlock Text="{local:T main.nearby}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Border x:Name="Switch" HorizontalAlignment="Right" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}"
              BorderThickness="1" CornerRadius="6" Padding="2">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="RadarChoice" Style="{StaticResource Segment}" Content="{local:T view.radar}" Tag="&#xEB44;"
                       GroupName="view" Checked="View_Checked"/>
          <RadioButton x:Name="ListChoice" Style="{StaticResource Segment}" Content="{local:T view.list}" Tag="&#xE8FD;"
                       GroupName="view" Checked="View_Checked" Margin="2,0,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- The stage -->
    <Border x:Name="Stage" Background="{DynamicResource RadarBg}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
            CornerRadius="12" ClipToBounds="True">
      <Grid>
        <Grid x:Name="RadarLayer" SizeChanged="RadarLayer_SizeChanged">
          <!-- Rings, ripples and the hub are placed by code from RadarGeometry -->
          <Canvas x:Name="Rings" IsHitTestVisible="False"/>
          <ItemsControl x:Name="RadarItems" ItemTemplate="{StaticResource RadarNode}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:RadarPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <StackPanel x:Name="Hint" VerticalAlignment="Bottom" Margin="24,0,24,18" IsHitTestVisible="False">
            <TextBlock x:Name="HintTitle" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="HintText" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="ListLayer" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl x:Name="ListItems" ItemTemplate="{StaticResource ListRow}" Focusable="False"/>
          </ScrollViewer>
          <StackPanel x:Name="ListHint" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
            <TextBlock x:Name="ListHintTitle" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="ListHintText" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
