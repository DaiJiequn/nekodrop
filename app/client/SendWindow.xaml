<Window x:Class="NekoDrop.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T send.title}" Width="460" Height="620" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" AllowDrop="True"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Subtle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Padding" Value="20,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- What is being sent -->
    <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1"
            CornerRadius="8" Padding="12,10">
      <DockPanel>
        <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0">
          <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource Accent}" Opacity="0.15"/>
          <TextBlock FontFamily="{DynamicResource IconFont}" Text="&#xE8A5;" FontSize="20" Foreground="{DynamicResource AccentText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SizeText" Style="{StaticResource Caption}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Who to send to: the same radar / list as the main window -->
    <local:RadarView Grid.Row="2" Margin="0,16,0,0"/>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{local:T send.close}" Style="{StaticResource Subtle}" Click="Close_Click" IsCancel="True"/>
      <TextBlock VerticalAlignment="Center">
        <Hyperlink Click="More_Click" Foreground="{DynamicResource AccentText}"><Run Text="{local:T send.more}"/></Hyperlink>
      </TextBlock>
    </DockPanel>
  </Grid>
</Window>
