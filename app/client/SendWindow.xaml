<Window x:Class="NekoDrop.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T send.title}" Width="440" Height="650" MinWidth="400" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" AllowDrop="True"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource UiFont}" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="48"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource TitleButton}" Click="Close_Click" AutomationProperties.Name="Close"
                VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <local:AirDropMark Width="18" Height="18" Brush="{DynamicResource Accent}" Margin="0,0,8,0"/>
          <TextBlock Text="{local:T send.title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="1" Margin="16">
      <!-- What is being sent -->
      <Border DockPanel.Dock="Top" Style="{StaticResource WinCard}" Padding="12,10" Margin="0,0,0,14">
        <DockPanel>
          <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,1" Background="{DynamicResource AccentSubtle}" VerticalAlignment="Center">
            <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource Accent}"/>
          </Border>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
          <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <!-- Who to send to -->
      <local:RadarView x:Name="Radar"/>
    </DockPanel>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource WinButton}" Content="{local:T send.more}" Click="More_Click"/>
          <Button Style="{StaticResource WinButton}" Content="{local:T send.close}" Click="Close_Click" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="HintText" FontSize="12" Foreground="{DynamicResource Text3}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
