<Window x:Class="NekoDrop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nekodrop 设置" Width="520" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,16,24,20">
      <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="设备名称" FontWeight="SemiBold"/>
          <TextBlock Text="iPhone 的 AirDrop 列表里显示的名字" Style="{StaticResource Caption}"/>
          <TextBox x:Name="NameBox" Margin="0,8,0,0" Padding="6,4" MaxLength="40"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="保存位置" FontWeight="SemiBold"/>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="更改…" Click="Browse_Click" Margin="8,0,0,0" Padding="12,4"/>
            <TextBox x:Name="FolderBox" Padding="6,4" IsReadOnly="True"/>
          </DockPanel>
          <CheckBox x:Name="AskBox" Content="接收前先询问我"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="网络与 AirDrop" FontWeight="SemiBold"/>
          <RadioButton x:Name="ModeConcurrent" GroupName="mode" Content="同时联网和 AirDrop（推荐）"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0"
                     Text="nekodrop 自己连接你当前的 Wi-Fi，同时保持 AirDrop 可用。支持 WPA2 个人版和开放网络；WPA3、企业网会自动改用“按需”。"/>
          <RadioButton x:Name="ModeOnDemand" GroupName="mode" Content="按需接管网卡"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0"
                     Text="平时由 Intel 驱动正常上网；附近的 iPhone 打开 AirDrop 或你发送文件时才接管网卡，传输期间会短暂断网。"/>
          <RadioButton x:Name="ModeOff" GroupName="mode" Content="关闭 AirDrop"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="总是接受的设备" FontWeight="SemiBold"/>
          <TextBlock Text="这些设备发来的文件不再询问。设备只按它自报的名称和型号识别。" Style="{StaticResource Caption}"/>
          <ListBox x:Name="TrustedList" Height="80" Margin="0,8,0,0"/>
          <Button Content="移除所选" Click="RemoveTrusted_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,4"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <CheckBox x:Name="StartupBox" Content="登录 Windows 时启动 nekodrop" Margin="0"/>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="保存" Click="Save_Click" Padding="20,6" IsDefault="True"/>
        <Button Content="取消" Click="Cancel_Click" Padding="20,6" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
