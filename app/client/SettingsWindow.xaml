<Window x:Class="NekoDrop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NekoDrop"
        Title="{local:T set.title}" Width="520" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Window}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14">
  <Window.Resources>
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,16,24,20">
      <TextBlock Text="{local:T set.heading}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.name}" FontWeight="SemiBold"/>
          <TextBlock Text="{local:T set.nameHint}" Style="{StaticResource Caption}"/>
          <TextBox x:Name="NameBox" Margin="0,8,0,0" Padding="6,4" MaxLength="40"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.folder}" FontWeight="SemiBold"/>
          <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{local:T main.change}" Click="Browse_Click" Margin="8,0,0,0" Padding="12,4"/>
            <TextBox x:Name="FolderBox" Padding="6,4" IsReadOnly="True"/>
          </DockPanel>
          <CheckBox x:Name="AskBox" Content="{local:T set.ask}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.network}" FontWeight="SemiBold"/>
          <RadioButton x:Name="ModeConcurrent" GroupName="mode" Content="{local:T mode.concurrent}"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0"
                     Text="{local:T mode.concurrent.hint}"/>
          <RadioButton x:Name="ModeOnDemand" GroupName="mode" Content="{local:T mode.ondemand}"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0"
                     Text="{local:T mode.ondemand.hint}"/>
          <RadioButton x:Name="ModeOff" GroupName="mode" Content="{local:T mode.off}"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.trusted}" FontWeight="SemiBold"/>
          <TextBlock Text="{local:T set.trustedHint}" Style="{StaticResource Caption}"/>
          <ListBox x:Name="TrustedList" Height="80" Margin="0,8,0,0"/>
          <Button Content="{local:T set.remove}" Click="RemoveTrusted_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,4"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.language}" FontWeight="SemiBold"/>
          <ComboBox x:Name="LanguageBox" Margin="0,8,0,0" HorizontalAlignment="Left" MinWidth="200">
            <ComboBoxItem Tag="auto" Content="{local:T lang.auto}"/>
            <ComboBoxItem Tag="zh" Content="简体中文"/>
            <ComboBoxItem Tag="en" Content="English"/>
          </ComboBox>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <CheckBox x:Name="StartupBox" Content="{local:T set.startup}" Margin="0"/>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.updates}" FontWeight="SemiBold"/>
          <CheckBox x:Name="CheckUpdatesBox" Content="{local:T set.checkUpdates}"/>
          <CheckBox x:Name="PreviewUpdatesBox" Content="{local:T set.previewUpdates}"/>
          <TextBlock Style="{StaticResource Caption}" Text="{local:T set.updates.hint}"/>
          <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CheckNowButton" Content="{local:T set.checkNow}" Click="CheckNow_Click" Padding="12,4"/>
              <Button x:Name="OpenReleasesButton" Content="{local:T update.openReleases}" Click="OpenReleases_Click" Padding="10,4" Margin="6,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.card}" FontWeight="SemiBold"/>
          <TextBlock x:Name="CardStatus" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
          <TextBlock Style="{StaticResource Caption}" Text="{local:T set.card.hint}" Margin="0,4,0,0"/>
          <ComboBox x:Name="CardBox" Margin="0,8,0,0" DisplayMemberPath="Label"/>
          <ComboBox x:Name="ModelBox" Margin="0,6,0,0" DisplayMemberPath="Label"/>
          <DockPanel Margin="0,6,0,0">
            <Button x:Name="CardApply" Content="{local:T set.card.apply}" Click="CardApply_Click" Padding="12,4" DockPanel.Dock="Left"/>
            <Button x:Name="CardAuto" Content="{local:T set.card.auto}" Click="CardAuto_Click" Padding="12,4" Margin="6,0,0,0" DockPanel.Dock="Left"/>
            <TextBlock x:Name="CardError" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="{local:T set.experimental}" FontWeight="SemiBold"/>
          <CheckBox x:Name="FastUnlockBox" Content="{local:T set.fastUnlock}"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0" Text="{local:T set.fastUnlock.hint}"/>
          <CheckBox x:Name="CoexPlanBox" Content="{local:T set.coexPlan}" Margin="0,8,0,0"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0" Text="{local:T set.coexPlan.hint}"/>
          <CheckBox x:Name="BtCoexBox" Content="{local:T set.btCoex}" Margin="0,8,0,0"/>
          <TextBlock Style="{StaticResource Caption}" Margin="20,0,0,0" Text="{local:T set.btCoex.hint}"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="{local:T set.save}" Click="Save_Click" Padding="20,6" IsDefault="True"/>
        <Button Content="{local:T set.cancel}" Click="Cancel_Click" Padding="20,6" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
